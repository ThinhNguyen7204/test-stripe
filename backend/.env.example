# ============================================================================
#  OptiSigns Billing Demo — backend configuration
#  Copy this file to `.env` and fill in the values. `.env` is gitignored.
# ============================================================================


# ---------------------------------------------------------------- SERVER ----

# Port of the NestJS API. The frontend (Vite, port 5555) proxies /api here,
# so changing this port means changing `frontend/vite.config.ts` as well.
PORT=3123

# URL of the frontend. Used as the `return_url` when opening the Stripe Customer
# Portal and as the `success_url`/`cancel_url` of a Checkout session (mode=setup).
FRONTEND_URL=http://localhost:5555


# --------------------------------------------------------------- MONGODB ----

# MongoDB connection string. As the demo requires, Mongo runs on port 27099:
#   mongod --port 27099 --dbpath ./.mongo-data
# The app creates its collections itself: accounts, catalog_items,
# billing_policies, billing_events. No migration is needed.
MONGO_URI=mongodb://127.0.0.1:27099/optisigns_billing_demo


# ----------------------------------------------------------------- STRIPE ----

# REQUIRED. A TEST MODE secret key — it always starts with `sk_test_`.
# Get it at: https://dashboard.stripe.com/test/apikeys  (the "Secret key" entry)
#
# The app uses this key for every server-side operation: creating products and
# prices, customers, subscriptions, prorations, subscription schedules, credit
# notes, refunds and test clocks.
#
# DO NOT use a live key (`sk_live_`): the demo creates and cancels
# subscriptions and issues real refunds.
# The app treats a value ending in "xxx" as not configured.
STRIPE_SECRET_KEY=sk_test_xxx

# OPTIONAL. Publishable key (`pk_test_`), from the same dashboard page as above.
# Only needed if you later want to embed Stripe Elements to enter cards in the UI.
# The demo currently attaches cards with Stripe's test payment-method tokens
# (pm_card_visa, pm_card_chargeDeclined, ...), so it is not required.
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# OPTIONAL but recommended. The webhook signing secret (`whsec_`).
# Run: stripe listen --forward-to localhost:3123/api/webhooks/stripe
# When the CLI prints whsec_..., paste it here and restart the backend.
#
# With a secret     -> the app verifies signatures (as in production).
# Without a secret  -> the endpoint still accepts unsigned payloads, handy for
#                      local testing with curl.
#
# The webhook is used to sync subscription state back into Mongo, write the
# activity log, and apply the dunning policy on invoice.payment_failed.
STRIPE_WEBHOOK_SECRET=whsec_xxx


# --------------------------------------------------------------- BILLING ----

# Currency used to create Prices on Stripe and to display amounts in the UI
# (lower-case ISO code). OptiSigns lists USD/EUR/GBP/AUD/CAD. Note: once the
# catalog has been synced in one currency, switching to another requires
# running the sync again to create a new set of Prices.
CURRENCY=usd
